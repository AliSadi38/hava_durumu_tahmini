<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hava Durumu</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Figtree:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="style.css" />
  </head>
  <body>
    <main class="app">
      <form class="search" id="searchForm" role="search">
        <input
          id="searchInput"
          type="search"
          placeholder="Şehir ara… (örn. İzmir)"
          aria-label="Şehir ara"
          autocomplete="off"
        />
        <button type="submit">Ara</button>
      </form>

      <p class="message" id="message" role="status" hidden></p>

      <section class="current" id="current" aria-live="polite">
        <div class="place">
          <h1 id="city">—</h1>
          <p id="date"></p>
        </div>
        <div class="reading">
          <span class="temp" id="temp">--°</span>
          <img id="icon" alt="" width="120" height="120" />
        </div>
        <p class="desc" id="desc"></p>

        <dl class="details">
          <div>
            <dt>Hissedilen</dt>
            <dd id="feels">--</dd>
          </div>
          <div>
            <dt>Nem</dt>
            <dd id="humidity">--</dd>
          </div>
          <div>
            <dt>Rüzgar</dt>
            <dd id="wind">--</dd>
          </div>
          <div>
            <dt>Basınç</dt>
            <dd id="pressure">--</dd>
          </div>
        </dl>
      </section>

      <section class="forecast" aria-label="5 günlük tahmin">
        <h2>Önümüzdeki günler</h2>
        <div class="days" id="days"></div>
      </section>
    </main>

    <script src="script.js"></script>
  </body>
</html>



:root {
  --bg: #eef4f6;
  --bg-accent: #dcebf0;
  --card: #ffffff;
  --ink: #1f3340;
  --ink-soft: #6b8190;
  --accent: #3f8fa8;
  --accent-soft: #e3f1f5;
  --radius: 22px;
  --shadow: 0 12px 40px rgba(46, 89, 108, 0.1);
  --ease: 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
}

* {
  box-sizing: border-box;
  margin: 0;
}

body {
  min-height: 100vh;
  font-family: "Figtree", system-ui, sans-serif;
  color: var(--ink);
  background: radial-gradient(
      120% 80% at 80% 0%,
      var(--bg-accent),
      var(--bg) 60%
    )
    fixed;
  display: flex;
  justify-content: center;
  padding: clamp(16px, 5vw, 56px) 16px;
}

.app {
  width: 100%;
  max-width: 720px;
  display: grid;
  gap: 22px;
  align-content: start;
}

/* Arama */
.search {
  display: flex;
  gap: 8px;
  padding: 6px;
  background: var(--card);
  border-radius: 999px;
  box-shadow: var(--shadow);
  transition: box-shadow var(--ease);
}
.search:focus-within {
  box-shadow:
    0 0 0 3px var(--accent-soft),
    var(--shadow);
}
.search input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  font: inherit;
  padding: 12px 18px;
  color: var(--ink);
}
.search input::placeholder {
  color: var(--ink-soft);
}
.search button {
  border: 0;
  cursor: pointer;
  font: inherit;
  font-weight: 600;
  color: #fff;
  background: var(--accent);
  padding: 0 26px;
  border-radius: 999px;
  transition:
    transform var(--ease),
    background var(--ease);
}
.search button:hover {
  background: #327a92;
}
.search button:active {
  transform: scale(0.96);
}

.message {
  padding: 12px 18px;
  border-radius: 14px;
  background: #fff3ef;
  color: #a2432c;
}

/* Güncel hava */
.current {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: clamp(22px, 5vw, 38px);
  transition:
    opacity var(--ease),
    transform var(--ease);
}
.current.loading {
  opacity: 0.45;
  transform: translateY(4px);
}

.place h1 {
  font-family: "Fraunces", Georgia, serif;
  font-weight: 600;
  font-size: clamp(1.8rem, 5vw, 2.4rem);
}
.place p {
  color: var(--ink-soft);
  margin-top: 2px;
}

.reading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8px;
}
.temp {
  font-family: "Fraunces", Georgia, serif;
  font-weight: 400;
  font-size: clamp(4.5rem, 16vw, 7rem);
  line-height: 1;
  letter-spacing: -0.03em;
}
.reading img {
  width: clamp(90px, 22vw, 130px);
  height: auto;
  margin: -8px -8px -8px 0;
}
.desc {
  font-size: 1.15rem;
  color: var(--accent);
  font-weight: 500;
  text-transform: capitalize;
}

.details {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin-top: 26px;
}
.details div {
  background: var(--accent-soft);
  border-radius: 16px;
  padding: 14px 12px;
  text-align: center;
}
.details dt {
  font-size: 0.8rem;
  color: var(--ink-soft);
}
.details dd {
  font-weight: 600;
  margin-top: 4px;
}

/* Tahmin */
.forecast h2 {
  font-family: "Fraunces", Georgia, serif;
  font-weight: 600;
  font-size: 1.2rem;
  margin: 6px 4px 12px;
}
.days {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10px;
}
.day {
  background: var(--card);
  border-radius: 18px;
  padding: 14px 6px;
  text-align: center;
  box-shadow: var(--shadow);
  transition: transform var(--ease);
}
.day:hover {
  transform: translateY(-4px);
}
.day h3 {
  font-size: 0.9rem;
  font-weight: 600;
}
.day img {
  width: 54px;
  height: 54px;
}
.day .hi {
  font-weight: 600;
}
.day .lo {
  color: var(--ink-soft);
  font-size: 0.9rem;
}

@media (max-width: 600px) {
  .details {
    grid-template-columns: repeat(2, 1fr);
  }
  .days {
    grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
  }
}
@media (prefers-reduced-motion: reduce) {
  * {
    transition: none !important;
  }
}
:focus-visible {
  outline: 3px solid var(--accent);
  outline-offset: 2px;
}





/* ========================================================
   API ANAHTARINIZI BURAYA YAPIŞTIRIN
   Ücretsiz anahtar: https://openweathermap.org/api
   ======================================================== */
const API_KEY = "550ccdf61d24de0c9084f5a55d08f5c8";

const DEFAULT_CITY = "Kocaeli";
const BASE_URL = "https://api.openweathermap.org/data/2.5";

const $ = (id) => document.getElementById(id);
const els = {
  form: $("searchForm"),
  input: $("searchInput"),
  message: $("message"),
  current: $("current"),
  city: $("city"),
  date: $("date"),
  temp: $("temp"),
  icon: $("icon"),
  desc: $("desc"),
  feels: $("feels"),
  humidity: $("humidity"),
  wind: $("wind"),
  pressure: $("pressure"),
  days: $("days"),
};

/* ---------- Veri çekme ---------- */
async function fetchJSON(endpoint, city) {
  const url = `${BASE_URL}/${endpoint}?q=${encodeURIComponent(city)}&units=metric&lang=tr&appid=${API_KEY}`;
  const res = await fetch(url);
  if (res.status === 401)
    throw new Error(
      "API anahtarı geçersiz ya da henüz etkinleşmemiş. Yeni anahtarlar birkaç saat sürebilir.",
    );
  if (res.status === 404)
    throw new Error(
      `"${city}" bulunamadı. Yazımı kontrol edip tekrar deneyin.`,
    );
  if (!res.ok)
    throw new Error(
      "Hava durumu alınamadı. Lütfen biraz sonra tekrar deneyin.",
    );
  return res.json();
}

async function loadCity(city) {
  if (API_KEY === "YOUR_API_KEY") {
    return showMessage(
      "script.js dosyasının en üstündeki API_KEY alanına OpenWeatherMap anahtarınızı yapıştırın.",
    );
  }
  els.current.classList.add("loading");
  hideMessage();
  try {
    const [current, forecast] = await Promise.all([
      fetchJSON("weather", city),
      fetchJSON("forecast", city),
    ]);
    renderCurrent(current);
    renderForecast(forecast.list);
  } catch (err) {
    showMessage(err.message);
  } finally {
    els.current.classList.remove("loading");
  }
}

/* ---------- DOM güncelleme ---------- */
function renderCurrent(d) {
  const w = d.weather[0];
  els.city.textContent = `${d.name}, ${d.sys.country}`;
  els.date.textContent = new Date().toLocaleDateString("tr-TR", {
    weekday: "long",
    day: "numeric",
    month: "long",
  });
  els.temp.textContent = `${Math.round(d.main.temp)}°`;
  els.icon.src = `https://openweathermap.org/img/wn/${w.icon}@4x.png`;
  els.icon.alt = w.description;
  els.desc.textContent = w.description;
  els.feels.textContent = `${Math.round(d.main.feels_like)}°`;
  els.humidity.textContent = `%${d.main.humidity}`;
  els.wind.textContent = `${Math.round(d.wind.speed * 3.6)} km/s`;
  els.pressure.textContent = `${d.main.pressure} hPa`;
}

function renderForecast(list) {
  // 3 saatlik veriyi günlere grupla
  const byDay = {};
  list.forEach((item) => (byDay[item.dt_txt.slice(0, 10)] ||= []).push(item));

  els.days.innerHTML = Object.entries(byDay)
    .slice(0, 5)
    .map(([date, items]) => {
      const temps = items.map((i) => i.main.temp);
      const mid =
        items.find((i) => i.dt_txt.includes("12:00")) ||
        items[Math.floor(items.length / 2)];
      const name = new Date(`${date}T12:00:00`).toLocaleDateString("tr-TR", {
        weekday: "short",
      });
      return `
      <article class="day">
        <h3>${name}</h3>
        <img src="https://openweathermap.org/img/wn/${mid.weather[0].icon.replace("n", "d")}@2x.png" alt="${mid.weather[0].description}">
        <p class="hi">${Math.round(Math.max(...temps))}°</p>
        <p class="lo">${Math.round(Math.min(...temps))}°</p>
      </article>`;
    })
    .join("");
}

function showMessage(text) {
  els.message.textContent = text;
  els.message.hidden = false;
}
function hideMessage() {
  els.message.hidden = true;
}

/* ---------- Arama ---------- */
els.form.addEventListener("submit", (e) => {
  e.preventDefault();
  const city = els.input.value.trim();
  if (city) loadCity(city);
});

/* ---------- Başlangıç ---------- */
loadCity(DEFAULT_CITY);
